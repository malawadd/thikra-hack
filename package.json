{
  "name": "thikra",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "dev": "concurrently --names web,api --prefix-colors blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @thikra/web dev",
    "dev:api": "node scripts/run-api.mjs",
    "build": "pnpm --filter @thikra/web build",
    "lint": "pnpm --filter @thikra/web lint && pnpm lint:api",
    "lint:api": "node scripts/api-command.mjs ruff check .",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "node scripts/api-command.mjs pytest",
    "test:web": "pnpm --filter @thikra/web test",
    "test:e2e": "pnpm --filter @thikra/web test:e2e",
    "typecheck": "pnpm --filter @thikra/web typecheck",
    "check:structure": "node scripts/check-structure.mjs && node scripts/api-command.mjs pytest tests/test_structure.py -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
