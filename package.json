{
  "name": "thikra",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "dev": "concurrently --names web,api --prefix-colors blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @thikra/web dev",
    "dev:api": "node scripts/run-api.mjs",
    "dev:agent": "pnpm --filter @thikra/agent-client dev",
    "stop:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-app.ps1",
    "demo:agent": "node scripts/demo-agent.mjs",
    "demo:human": "node scripts/demo-human.mjs",
    "seed:commerce": "node scripts/api-command.mjs python -m app.commerce.seed_cli",
    "build": "pnpm --filter @thikra/web build && pnpm --filter @thikra/sdk typecheck && pnpm --filter @thikra/agent-client typecheck",
    "lint": "pnpm --filter @thikra/web lint && pnpm lint:api",
    "lint:api": "node scripts/api-command.mjs ruff check .",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "node scripts/api-command.mjs pytest",
    "test:web": "pnpm --filter @thikra/web test",
    "test:mcp": "node scripts/api-command.mjs pytest tests/test_mcp.py -q",
    "test:commerce": "node scripts/api-command.mjs pytest tests/test_commerce.py tests/test_mcp.py -q",
    "test:e2e": "pnpm --filter @thikra/web test:e2e",
    "typecheck": "pnpm --filter @thikra/web typecheck && pnpm --filter @thikra/sdk typecheck && pnpm --filter @thikra/agent-client typecheck",
    "check:structure": "node scripts/check-structure.mjs && node scripts/api-command.mjs pytest tests/test_structure.py -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
