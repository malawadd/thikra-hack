{
  "name": "@thikra/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cargo fetch --manifest-path src-tauri/Cargo.toml",
    "dev": "tauri dev",
    "dev:renderer": "vite dev --port 43193",
    "build": "vite build",
    "build:desktop": "tauri build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
