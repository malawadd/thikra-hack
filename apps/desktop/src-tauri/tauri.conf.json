{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thikra Studio",
  "version": "0.1.0",
  "identifier": "com.thikra.studio",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:43193",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:43192; img-src 'self' asset: http://127.0.0.1:43192 data: blob:; media-src 'self' http://127.0.0.1:43192 blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main-window"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Thikra Studio",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0a0c10"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Agent-assisted creative workflow studio"
  }
}
