# Thikra runtime: DEMO, SANDBOX, or PRODUCTION
APP_MODE=DEMO
DATABASE_URL=sqlite:///./thikra.db
THIKRA_DATA_DIR=.thikra
PUBLIC_WEB_URL=http://localhost:43191
# Exact comma-separated public/tunnel origins accepted by the SvelteKit BFF for mutations.
CSRF_TRUSTED_ORIGINS=
# PUBLIC_WEB_URL is the existing public-base setting and APP_MODE is the
# existing environment selector; duplicate THIKRA_* aliases are not consumed.
THIKRA_API_BASE_URL=http://localhost:43192
API_INTERNAL_URL=http://127.0.0.1:43192
API_CORS_ORIGINS=http://localhost:43191,http://127.0.0.1:43191
SESSION_SECRET=demo-only-change-me
MAX_GENERATION_CONCURRENCY=3
MAX_RUN_DURATION_SEC=1800

# Agent Gateway and deterministic commerce policy. Replace every development
# secret before production; full API-key values are shown only when issued.
THIKRA_API_KEY_PEPPER=demo-api-key-pepper-change-me
THIKRA_DEMO_API_KEY=thikra_test_demo_local_only
THIKRA_RECEIPT_SIGNING_PRIVATE_KEY=
THIKRA_RECEIPT_SIGNING_PUBLIC_KEY=
THIKRA_RECEIPT_SIGNING_KEY_ID=thikra-demo-ed25519-2026
THIKRA_WEBHOOK_SIGNING_SECRET=demo-webhook-secret-change-me
THIKRA_WEBHOOK_MAX_ATTEMPTS=5
THIKRA_WEBHOOK_TIMEOUT_SECONDS=10
THIKRA_WEBHOOK_DEVELOPMENT_ALLOWLIST=
THIKRA_QUOTE_TTL_SECONDS=900
THIKRA_RATE_LIMIT_REQUESTS=120
THIKRA_QUOTE_RATE_LIMIT_REQUESTS=30
THIKRA_RATE_LIMIT_WINDOW_SECONDS=60
THIKRA_DEFAULT_CURRENCY=USD
THIKRA_PLATFORM_MARGIN_BPS=1200
THIKRA_STORAGE_FEE_MINOR=20
THIKRA_VERIFICATION_FEE_MINOR=75
THIKRA_MERCHANT_NAME=Thikra Creative Services
THIKRA_MERCHANT_URL=https://thikra.example
THIKRA_MERCHANT_COUNTRY_CODE=SA

# Prava. Required in SANDBOX/PRODUCTION; never prefix secrets with PUBLIC_.
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
PRAVA_PUBLISHABLE_KEY=
PRAVA_SECRET_KEY=

# Backblaze B2. genblaze-s3 derives the endpoint from B2_REGION.
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Provider keys. DEMO boots without them; SANDBOX uses configured providers.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
DECART_API_KEY=
GMI_API_KEY=
RUNWAY_API_SECRET=
LUMA_API_KEY=
ELEVENLABS_API_KEY=
LMNT_API_KEY=
HUME_API_KEY=

# Curated model defaults
CHAT_MODEL=gpt-4.1-nano
IMAGE_MODEL=imagen-4.0-generate-001
VIDEO_PROVIDER=gmicloud
GMI_VIDEO_MODEL=Kling-Image2Video-V2.1-Master
VIDEO_MODEL=lucy-2.1
TTS_MODEL=nvidia/magpie-tts-multilingual
MUSIC_MODEL=minimax-music-2.5

LOG_LEVEL=INFO
OTEL_ENDPOINT=
STEP_CACHE_DIR=.cache/explainers
